# Vorlage für .env.local — keine echten Schlüssel hier eintragen.
# Dieselben Variablen müssen in Vercel unter "Environment Variables" gesetzt sein
# (Production, Preview, Development).

# --- Pflicht: ohne diese Werte funktionieren Upload und E-Mail-Versand nicht ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # niemals mit NEXT_PUBLIC_ prefixen
RESEND_API_KEY=

# --- Optional: Vorschau und Messung ---
SITE_PASSWORD=                      # Passwortschutz der Vorschau (proxy.ts)
PLAUSIBLE_SRC=                      # seitenspezifische Skript-URL aus dem Plausible-Dashboard

# --- Optional: Adressen und Kennungen (P1-7) ---
# Fehlt eine Variable, greift der in Klammern genannte Standardwert.
EMAIL_FROM=                         # Absender beider Mails (Standard: "Nota Finance Service <service@notafinance.de>")
EMAIL_INTERNAL_RECIPIENT=           # Empfänger der internen Benachrichtigung (Standard: admin@notafinance.de)
NEXT_PUBLIC_SUPPORT_EMAIL=          # Kontaktadresse für Kunden (Standard: service@notafinance.de)
NEXT_PUBLIC_SUPABASE_BUCKET=        # Storage-Bucket (Standard: invoices)

# --- Automatischer Löschlauf (P1-4) ---
CRON_SECRET=                        # Geheimwort für /api/cron/loeschlauf. Vercel sendet es beim
                                    # Cron-Aufruf automatisch mit; ohne Übereinstimmung: 401.
                                    # Mindestens 16 zufällige Zeichen.
LOESCHLAUF_AKTIV=                   # "true" = es wird wirklich gelöscht. Fehlt der Wert oder
                                    # steht etwas anderes drin, läuft jeder Lauf als Probelauf
                                    # (zählt und protokolliert, löscht nichts).
                                    # Erst auf "true" setzen, wenn P1-10 erledigt ist — vorher
                                    # gibt es keine Sicherung und Löschen ist unumkehrbar.
